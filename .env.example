PORT=3000

# Banco PostgreSQL
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/seguro_auto_ai

# Gemini (preferencialmente via arquivo secret)
GEMINI_MODEL=gemini-1.5-pro
GEMINI_API_KEY_FILE=/run/secrets/gemini_api_key
# GEMINI_API_KEY=sua_chave_aqui

# SMTP para envio de email
# Deixe vazio em desenvolvimento para desabilitar envio real.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Frontend (opcional para execução separada)
VITE_API_BASE_URL=http://localhost:3000

# Segurança mínima
ADMIN_API_KEY=dev-admin-key-change-me
CORS_ORIGIN=http://localhost:8080,http://localhost:3000
CHAT_RATE_LIMIT_WINDOW_MS=60000
CHAT_RATE_LIMIT_MAX=30

# Camada Python de comunicacao do agente
PYTHON_AGENT_ENABLED=true

# Estilo de voz do agente (consultiva|executiva)
AGENT_VOICE_STYLE=consultiva
